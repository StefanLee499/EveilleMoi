# Calendly inline embed (required for the booking section to render)
# Example: https://calendly.com/your-handle/30min
NEXT_PUBLIC_CALENDLY_URL=

# Optional: signing key from Calendly webhook subscription.
# When set, POST /api/calendly/webhook verifies the Calendly-Webhook-Signature header.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Optional: personal access token if you later add server-to-server Calendly API calls.
CALENDLY_API_TOKEN=
